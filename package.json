{
	"name": "vestig-monorepo",
	"version": "0.23.0",
	"private": true,
	"workspaces": ["packages/*", "apps/*"],
	"catalog": {
		"// TypeScript": "",
		"typescript": "^6.0.3",
		"@types/node": "^22.19.19",
		"// React 19.2": "",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.0.0",
		"// Next.js 16": "",
		"next": "16.2.6",
		"// MDX": "",
		"@next/mdx": "16.2.6",
		"@mdx-js/loader": "^3.1.0",
		"@mdx-js/react": "^3.1.1",
		"@types/mdx": "^2.0.13"
	},
	"scripts": {
		"build": "bun run --filter 'vestig' build && bun run --filter '@vestig/next' build && bun run --filter '@vestig/web' build",
		"test": "bun run --filter '*' test && bun test scripts/__tests__/*.test.ts",
		"lint": "biome check .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"typecheck": "bun run --filter '*' typecheck",
		"release": "bun scripts/release.ts",
		"bench": "bun run packages/vestig/bench/index.ts",
		"validate:version": "bun scripts/validate-version.ts",
		"validate:docs": "bun scripts/validate-docs.ts",
		"validate:changelog": "bun scripts/sync-changelog.ts",
		"validate:release-notes": "bun scripts/validate-release-notes.ts",
		"validate:security": "bun scripts/validate-security.ts",
		"validate:package-contents": "bun scripts/validate-package-contents.ts",
		"validate:llms": "bun scripts/validate-llms.ts",
		"prepare": "bun scripts/setup-hooks.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"mitata": "^1.0.34",
		"pino": "^10.3.1",
		"typescript": "^6.0.3",
		"winston": "^3.19.0"
	}
}
