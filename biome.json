{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/bun.lock",
			"!**/.next",
			"!**/.vercel",
			"!**/next-env.d.ts"
		]
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"defaultBranch": "main",
		"useIgnoreFile": true
	},
	"assist": { "actions": { "source": { "organizeImports": "off" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"noStaticElementInteractions": "warn",
				"useAriaPropsSupportedByRole": "warn",
				"useButtonType": "warn",
				"useKeyWithClickEvents": "warn",
				"useSemanticElements": "warn",
				"noLabelWithoutControl": "warn",
				"useFocusableInteractive": "warn",
				"noSvgWithoutTitle": "warn",
				"noNoninteractiveTabindex": "warn"
			},
			"style": {
				"noNonNullAssertion": "warn"
			},
			"complexity": {
				"noForEach": "warn",
				"noBannedTypes": "warn"
			},
			"correctness": {
				"useExhaustiveDependencies": "warn",
				"noChildrenProp": "warn"
			},
			"suspicious": {
				"noArrayIndexKey": "warn",
				"noExplicitAny": "warn"
			},
			"security": {
				"noDangerouslySetInnerHtml": "warn"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded"
		}
	},
	"json": {
		"formatter": {
			"enabled": true,
			"trailingCommas": "none"
		}
	},
	"overrides": [
		{
			"includes": ["**/package.json"],
			"json": {
				"formatter": {
					"expand": "auto"
				}
			}
		}
	]
}
